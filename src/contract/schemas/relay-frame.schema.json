{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/relay-frame.schema.json",
  "title": "Relay frame (fabric-relay/0.1, DEC-0047)",
  "description": "One UTF-8 JSON text frame of the relay protocol, at most 1 MiB. Unknown members are ignored; an unknown type is answered with an error frame of code unknown-type. FAC-SEM-071 checks the limits a schema cannot say.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "protocol",
        "relay",
        "nonce",
        "time"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "hello"
        },
        "protocol": {
          "const": "fabric-relay/0.1"
        },
        "relay": {
          "type": "string",
          "pattern": "^(?:https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|\\[(?:(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){7}(?:0|[1-9a-f][0-9a-f]{0,3})|(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){1,7}:|(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){1,6}:(?:0|[1-9a-f][0-9a-f]{0,3})|(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){1,5}(?::(?:0|[1-9a-f][0-9a-f]{0,3})){1,2}|(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){1,4}(?::(?:0|[1-9a-f][0-9a-f]{0,3})){1,3}|(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){1,3}(?::(?:0|[1-9a-f][0-9a-f]{0,3})){1,4}|(?:(?:0|[1-9a-f][0-9a-f]{0,3}):){1,2}(?::(?:0|[1-9a-f][0-9a-f]{0,3})){1,5}|(?:0|[1-9a-f][0-9a-f]{0,3}):(?::(?:0|[1-9a-f][0-9a-f]{0,3})){1,6}|:(?:(?::(?:0|[1-9a-f][0-9a-f]{0,3})){1,7}|:))\\]|(?=[a-z0-9.-]{1,253}(?::|$))(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*(?![0-9]+(?::|$))(?!0x[0-9a-f]*(?::|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?::(?!443$)(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?|http://(?:127\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])|\\[::1\\])(?::(?!80$)(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?)$",
          "description": "the relay's origin, serialised: https on a lowercase host name (at most 253 characters, its last label not a number), a dotted IPv4 address or a bracketed lowercase IPv6 address; or http on a loopback literal (127.0.0.0/8 or [::1]) for a relay on the same machine; a port of 1 to 65535 that is not the scheme's default, and nothing after it (DEC-0066, isRelayOrigin)"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "protocol",
        "alg",
        "estate",
        "kid",
        "iat",
        "sig"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "auth"
        },
        "protocol": {
          "type": "string"
        },
        "estate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "iat": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "alg": {
          "type": "string",
          "description": "the signature algorithm, signed in relay-auth/1; ES256 is the only one admitted (FAC-SEM-071, unsupported-alg)"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "session",
        "estateRevision",
        "deltaHead",
        "heartbeat"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "welcome"
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "estateRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "the revision (1 or more) of the verified estate record the relay admits from; a relay with none admits nobody, so an estate's welcome always carries it"
        },
        "deltaHead": {
          "$ref": "revocation-delta.schema.json#/$defs/head",
          "description": "The head of the revocation delta: the same shape as device check-in records.revocationDelta (DEC-0054)."
        },
        "heartbeat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "heartbeat.schema.json"
            }
          ],
          "description": "The relay's latest heartbeat (heartbeat/1, DEC-0054), unchanged, or null when it holds none."
        },
        "limits": {
          "type": "object",
          "description": "the limits this relay enforces, each optional and chosen by the relay; a frame over one is answered rate-limited or mailbox-full (DEC-0066)",
          "properties": {
            "sendPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "send frames per minute per session"
            },
            "presenceQueryPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "presence-query frames per minute per session"
            },
            "deltaQueryPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "delta-query frames per minute per session"
            },
            "mailboxMessages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "messages a recipient's mailbox holds"
            },
            "mailboxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "bytes a recipient's mailbox holds; omitted while the relay has no byte quota"
            },
            "blobBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "the largest blob, in bytes (at most MAX_BLOB_BYTES)"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "session",
        "list"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "welcome"
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "list": {
          "type": "object",
          "required": [
            "org",
            "revision",
            "digest"
          ],
          "properties": {
            "org": {
              "$ref": "org-membership.schema.json#/$defs/org"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "additionalProperties": false,
          "description": "DEC-0134: on an organization's relay, the member list (org-authority/1) the relay admits from: its organization, revision and digest. An organization has no heartbeat or revocation delta in this release, so this welcome carries none."
        },
        "limits": {
          "type": "object",
          "description": "the limits this relay enforces, each optional and chosen by the relay; a frame over one is answered rate-limited or mailbox-full (DEC-0066)",
          "properties": {
            "sendPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "send frames per minute per session"
            },
            "presenceQueryPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "presence-query frames per minute per session"
            },
            "deltaQueryPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "delta-query frames per minute per session"
            },
            "mailboxMessages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "messages a recipient's mailbox holds"
            },
            "mailboxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "bytes a recipient's mailbox holds; omitted while the relay has no byte quota"
            },
            "blobBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "the largest blob, in bytes (at most MAX_BLOB_BYTES)"
            }
          }
        }
      },
      "description": "The welcome of an organization's relay (DEC-0134): the session and the member list it admits from, in place of an estate's revision, delta head and heartbeat. It never carries estateRevision, which keeps it apart from an estate's welcome; other unknown members are ignored, as every frame's.",
      "not": {
        "required": [
          "estateRevision"
        ]
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "to",
        "msgId",
        "body",
        "ttl"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "send"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "msgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "body": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ttl": {
          "type": "integer"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "msgId",
        "seq"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "accepted"
        },
        "msgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "the id of the frame this answers (DEC-0066); unsolicited frames carry none"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "from",
        "msgId",
        "seq",
        "body",
        "sentAt"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "deliver"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "msgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "body": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sentAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "seq"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "ack"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "kid",
        "state",
        "lastSeen"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "presence"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "online",
            "offline"
          ]
        },
        "lastSeen": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "kids"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "presence-query"
        },
        "kids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 256
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "replyTo",
        "presences",
        "unknown"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "presence-result"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "the id of the presence-query this answers"
        },
        "presences": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "kid",
              "state",
              "lastSeen"
            ],
            "properties": {
              "kid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "state": {
                "enum": [
                  "online",
                  "offline"
                ]
              },
              "lastSeen": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
              }
            }
          },
          "description": "each asked kid of the asker's own owner that the relay has seen"
        },
        "unknown": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "each asked kid outside the asker's owner or never seen, alike, so nothing leaks across owners"
        }
      },
      "description": "The one terminal answer to a presence-query (DEC-0066): every asked kid appears exactly once in presences or unknown."
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "head",
        "entries"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "delta"
        },
        "head": {
          "$ref": "revocation-delta.schema.json#/$defs/head",
          "description": "The head the entries lead to: a hint; only a signed heartbeat's head binds (DEC-0054)."
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "revocation-delta.schema.json#/$defs/entry"
          },
          "description": "Consecutive signed entries (revocation-delta/1, DEC-0054), carried unchanged."
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "the id of the frame this answers (DEC-0066); unsolicited frames carry none"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "heartbeat"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "heartbeat"
        },
        "heartbeat": {
          "$ref": "heartbeat.schema.json",
          "description": "A signed heartbeat (heartbeat/1, DEC-0054), carried unchanged."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "fromSeq"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "delta-query"
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 0,
          "description": "The first entry the node lacks: its applied head's sequence plus one (DEC-0054)."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "ping"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "pong"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "the id of the frame this answers (DEC-0066); unsolicited frames carry none"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "id",
        "code",
        "message"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "error"
        },
        "code": {
          "enum": [
            "protocol-unsupported",
            "unauthenticated",
            "not-admitted",
            "bad-key",
            "unsupported-alg",
            "not-yet-valid",
            "replay",
            "unknown-type",
            "unknown-recipient",
            "too-large",
            "rate-limited",
            "mailbox-full",
            "expired",
            "digest-mismatch",
            "internal",
            "malformed",
            "recipients-mismatch"
          ],
          "description": "bad-key is reserved: since DEC-0066 no relay sends it (an unusable admitted key leaves the admission set and the request is unauthenticated); it stays so a frame from an older relay validates"
        },
        "message": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[^\\n]*$"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "the id of the frame this answers (DEC-0066); unsolicited frames carry none"
        },
        "retryAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "seconds before the node may send that frame type again, on rate-limited (DEC-0066)"
        }
      }
    }
  ]
}
