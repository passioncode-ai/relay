{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/common.schema.json",
  "title": "Fabric Agent Contract common definitions",
  "$defs": {
    "uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revisionRef": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "contentHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uri"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "revisionMeta": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "contentHash",
        "createdAt",
        "createdBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uri"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "createdBy": {
          "$ref": "#/$defs/uri"
        }
      },
      "additionalProperties": false
    },
    "dataClass": {
      "enum": [
        "public",
        "project-internal",
        "confidential",
        "personal",
        "credential",
        "regulated"
      ]
    },
    "effectClass": {
      "enum": [
        "none",
        "draft",
        "publish",
        "send",
        "reply",
        "charge",
        "delete",
        "merge",
        "deploy",
        "change-policy"
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "format": "uri"
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "mediaType",
        "uri",
        "contentHash",
        "classification",
        "producer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uri"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "$ref": "#/$defs/uri"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "classification": {
          "$ref": "#/$defs/dataClass"
        },
        "producer": {
          "$ref": "#/$defs/revisionRef"
        },
        "schema": {
          "$ref": "#/$defs/uri"
        }
      },
      "additionalProperties": false
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}(\\.[a-z][a-z0-9-]{0,31})?$",
      "description": "A registry agent id: a provider id, or a service id optionally followed by .instance (DEC-0016, DEC-0039)."
    },
    "capabilityName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "contextId": {
      "type": "string",
      "pattern": "^(?:personal|org:[A-Za-z0-9][A-Za-z0-9_-]{0,127})$",
      "description": "DEC-0082: the context a grant is used in or an agent instance runs in: personal, or org:<orgId>, where orgId is the organization server's opaque id of the organization: a letter or digit, then up to 127 of [A-Za-z0-9_-] (1-128 characters, an enrollment's org.id can be any such id). Compared as written: never case-folded, never by prefix (docs/specification/contexts.md)."
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
    },
    "usage": {
      "type": "object",
      "required": [
        "inputTokens",
        "outputTokens",
        "wallMs"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheReadTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWriteTokens": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "protocolRevision": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}/[0-9]{1,4}(\\.[0-9]{1,4}){0,2}$",
      "description": "A protocol revision, <name>/<revision> (DEC-0009, DEC-0067)."
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/protocolRevision"
      },
      "description": "The protocol revisions a party reads (DEC-0067): for each protocol at most N and N−1, consecutive in the contract's register (FAC-SEM-099)."
    }
  }
}
