{
  "name": "@passioncode/relay",
  "version": "0.0.0",
  "private": true,
  "description": "PassionCode relay: carries sessions, sealed envelopes and package blobs between a person's or an organization's machines. Holds no authority and no plaintext.",
  "license": "AGPL-3.0-only OR LicenseRef-PassionCode-Commercial",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:worker": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist/worker",
    "test": "npm run build:worker && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "portable": "node --import tsx src/portable/main.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "24.19.2",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
